local Workspace = game:GetService("Workspace")

local discovered = {}
local count = 0

local function processObject(obj)
    if obj.Name == "EnterAuction" and obj:IsA("ProximityPrompt") then
        if not discovered[obj] then
            discovered[obj] = true
            obj.HoldDuration = 0
            count += 1

            print("Updated new auction prompt:", obj:GetFullName())
        end
    end
end

-- Find all existing auction prompts
for _, obj in ipairs(Workspace:GetDescendants()) do
    processObject(obj)
end

print("Initial scan complete. Found", count, "auction prompts.")

-- Only check objects as they're newly loaded into Workspace
Workspace.DescendantAdded:Connect(function(obj)
    processObject(obj)
end)
