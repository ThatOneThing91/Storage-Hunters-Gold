local Workspace = game:GetService("Workspace")

local function makeInstant(obj)
    if obj.Name == "EnterAuction" and obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0
        print("Set instant:", obj:GetFullName())
    end
end

-- Update all currently loaded auction prompts
for _, obj in ipairs(Workspace:GetDescendants()) do
    makeInstant(obj)
end

print("Initial auction scan complete.")

-- Update auction prompts whenever they are loaded/reloaded
Workspace.DescendantAdded:Connect(function(obj)
    makeInstant(obj)
end)
